########################
# Environment Variables Template
# 
# USAGE:
#   1. Copy this file to .env: cp env.template .env
#   2. Replace all placeholder values with your actual configuration
#   3. Set QUARKUS_PROFILE to 'local' or 'prod' to select the profile
#   4. Never commit .env to version control (it's in .gitignore)
#
# For production deployments, use secure environment variable management
# (Kubernetes secrets, AWS Secrets Manager, Azure Key Vault, etc.)
#
# NOTE: Create separate .env files for each environment (local, prod)
# and set QUARKUS_PROFILE accordingly.
########################

########################
# Profile Configuration
########################

# Set to 'local' or 'prod' to select the Quarkus profile
QUARKUS_PROFILE=local

########################
# HTTP Server Configuration
########################

HTTP_PORT=8080

########################
# Database Configuration
########################

# Database credentials
DB_USERNAME=quarkus
DB_PASSWORD=secret

# Database URL (used by application code)
# Format depends on your database setup
DB_URL=http://localhost:5432

# JDBC Connection String (used by Quarkus datasource)
# Format: jdbc:sqlserver://HOST:PORT;databaseName=DATABASE;encrypt=true;trustServerCertificate=true
# For PostgreSQL: jdbc:postgresql://HOST:PORT/DATABASE
DB_JDBC_URL=jdbc:postgresql://localhost:5432/foodpackaging_local

########################
# Profile-specific Configuration Codes
########################

KSK=KSK_LOCAL
KRC=KRC_LOCAL
KRCA=KRCA_LOCAL

########################
# CORS Configuration
########################

# CORS origin (leave empty for local, set to your domain for prod)
# Local profile defaults to http://localhost:3000 if empty
CORS_ORIGIN=
