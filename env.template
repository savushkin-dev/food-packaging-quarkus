########################
# Environment Variables Template
# 
# USAGE:
#   1. Copy this file to .env: cp env.template .env
#   2. Replace all placeholder values with your actual configuration
#   3. Never commit .env to version control (it's in .gitignore)
#
# For production deployments, use secure environment variable management
# (Kubernetes secrets, AWS Secrets Manager, Azure Key Vault, etc.)
########################

########################
# Database Configuration
# These are used by all profiles
########################

# Database credentials
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# Database URLs (used by application code)
# Format depends on your database setup
DB_URL_LOCAL=your_local_db_url
DB_URL_DEV=your_dev_db_url
DB_URL_PROD=your_prod_db_url
DB_URL_BRZPROD=your_brzprod_db_url
DB_URL_BARANPROD=your_baranprod_db_url

# JDBC Connection Strings (used by Quarkus datasource)
# Format: jdbc:sqlserver://HOST:PORT;databaseName=DATABASE;encrypt=true;trustServerCertificate=true
DB_JDBC_URL_LOCAL=jdbc:sqlserver://localhost:1433;databaseName=your_database;encrypt=true;trustServerCertificate=true
DB_JDBC_URL_DEV=jdbc:sqlserver://dev-server:1433;databaseName=your_database;encrypt=true;trustServerCertificate=true
DB_JDBC_URL_PROD=jdbc:sqlserver://prod-server:1433;databaseName=your_database;encrypt=true;trustServerCertificate=true
DB_JDBC_URL_BRZPROD=jdbc:sqlserver://brzprod-server:1433;databaseName=your_database;encrypt=true;trustServerCertificate=true
DB_JDBC_URL_BARANPROD=jdbc:sqlserver://baranprod-server:1433;databaseName=your_database;encrypt=true;trustServerCertificate=true

########################
# Profile-specific Configuration Codes
# Fill in the codes for each environment you plan to use
########################

# Local Profile (used with: -Dquarkus.profile=local)
KSK_LOCAL=your_ksk_code
KRC_LOCAL=your_krc_code
KRCA_LOCAL=your_krca_code

# Dev Profile (used with: -Dquarkus.profile=dev)
KSK_DEV=your_ksk_code
KRC_DEV=your_krc_code
KRCA_DEV=your_krca_code

# Production Profile (used with: -Dquarkus.profile=prod)
KSK_PROD=your_ksk_code
KRC_PROD=your_krc_code
KRCA_PROD=your_krca_code

# Brz Production Profile (used with: -Dquarkus.profile=brzprod)
KSK_BRZPROD=your_ksk_code
KRC_BRZPROD=your_krc_code
KRCA_BRZPROD=your_krca_code

# Baran Production Profile (used with: -Dquarkus.profile=baranprod)
KSK_BARANPROD=your_ksk_code
KRC_BARANPROD=your_krc_code
KRCA_BARANPROD=your_krca_code

########################
# CORS Configuration
# Allowed origins for cross-origin requests
########################

CORS_ORIGIN_DEV=http://localhost:3000
CORS_ORIGIN_PROD=https://your-prod-domain.com
CORS_ORIGIN_BRZPROD=https://your-brzprod-domain.com
CORS_ORIGIN_BARANPROD=https://your-baranprod-domain.com
